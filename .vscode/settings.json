{
  "files.associations": {
    "wrangler.json": "jsonc"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "node_modules": true,
    "dist": true,
    ".next": true,
    ".vinext": true,
    ".wrangler": true
  },
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5"
}
