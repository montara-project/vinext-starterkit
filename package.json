{
  "name": "vinext-starterkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "npm-run-all fmt lint:fix typecheck",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "lint:init": "oxlint --init",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:init": "oxfmt --init",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest",
    "predeploy": "npm run build",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "release": "release-it",
    "release:pre": "release-it --preRelease=beta",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/html": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@lexkit/editor": "^0.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "~8.21.3",
    "@vinext/cloudflare": "latest",
    "axios": "^1.19.0",
    "better-auth": "^1.6.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lexical": "^0.49.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "motion": "^13.1.0",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.5",
    "plyr-react": "^6.0.0",
    "qs": "^6.15.3",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-number-format": "^5.4.5",
    "react-server-dom-webpack": "latest",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/postcss": "latest",
    "@tanstack/react-devtools": "^0.10.10",
