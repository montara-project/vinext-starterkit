    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "eslint-plugin-perfectionist": "^5.10.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "release-it": "^21.0.2",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.10.0"
}
